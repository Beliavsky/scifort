{
  "schema_version": 1,
  "output_directory": "bindings/python/scifort",
  "groups": {
    "normal": {
      "manifest": "bindings/cabi_config/normal.json",
      "prefix": "normal_",
      "defaults": {
        "loc": 0.0,
        "scale": 1.0
      },
      "existing_functions": {
        "normal_pdf": {
          "symbol": "scifort_normal_pdf_f64",
          "vector_symbol": "scifort_normal_pdf_vec_f64",
          "array_argument": "x",
          "optional_policy": "required",
          "finite": [
            "loc",
            "scale"
          ],
          "positive": [
            "scale"
          ],
          "array_style": "pointer"
        },
        "normal_cdf": {
          "symbol": "scifort_normal_cdf_f64",
