            "fill": "zeros"
          },
          "shape": {
            "fill": "identity"
          },
          "df": 1.0,
          "allow_singular": false
        },
        "multivariate_t_logpdf": {
          "loc": {
            "fill": "zeros"
          },
          "shape": {
            "fill": "identity"
          },
          "df": 1.0
        },
        "multivariate_t_entropy": {
