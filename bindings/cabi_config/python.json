  "array_groups": {
    "linalg": {
      "manifests": [
        "bindings/cabi_config/linalg.json",
        "bindings/cabi_config/matrix_helpers.json"
      ],
      "defaults": {
        "psd_decompose": {
          "allow_singular": true
        }
      }
    },
    "multivariate_normal": {
      "manifests": [
        "bindings/cabi_config/multivariate_normal.json"
      ],
      "prefix": "multivariate_normal_",
      "defaults": {
        "multivariate_normal_pdf": {
          "mean": {
            "fill": "zeros"
          },
          "cov": {
            "fill": "identity"
          },
          "allow_singular": false
        },
        "multivariate_normal_logpdf": {
          "mean": {
            "fill": "zeros"
          },
          "cov": {
            "fill": "identity"
          },
          "allow_singular": false
        },
        "multivariate_normal_entropy": {
          "mean": {
            "fill": "zeros"
          },
          "cov": {
            "fill": "identity"
          }
        }
      },
      "dimension_defaults": {
        "multivariate_normal_entropy": {
          "n": 1
        }
      },
      "dimension_sources": {
        "multivariate_normal_entropy": {
          "n": [
            {
              "argument": "mean",
              "axis": null
            },
            {
              "argument": "cov",
              "axis": 1
            }
          ]
        }
      },
      "zero_based_indices": {
        "multivariate_normal_marginal": {
          "dimensions": "n"
        }
      },
      "output_dimensions": {
        "multivariate_normal_rvs_array": {
          "n": 1,
          "n_samples": 1
        }
      }
    },
    "multivariate_t": {
