          "finite": [
            "loc",
            "scale"
          ],
          "positive": [
            "scale"
          ],
          "array_style": "pointer"
        },
        "normal_ppf": {
          "symbol": "scifort_normal_ppf_f64",
          "vector_symbol": "scifort_normal_ppf_vec_f64",
          "array_argument": "p",
          "optional_policy": "required",
          "finite": [
            "loc",
            "scale"
          ],
          "positive": [
            "scale"
          ],
          "array_style": "pointer"
